{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dataeng-dev-uks-01"
		},
		"LS_SQL_SERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SERVER'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stdataengdevuks01.dfs.core.windows.net/"
		},
		"LS_SQL_SERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-dataeng-dev-uks-01.database.windows.net"
		},
		"LS_SQL_SERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-dataeng-dev-01"
		},
		"LS_SQL_SERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"TGR_EVERNT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().filename"
		},
		"TGR_EVERNT_SIMPLE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/ecfb7077-d071-4f73-98f1-0c5f8879e945/resourceGroups/rg-dataeng-dev-uks/providers/Microsoft.Storage/storageAccounts/stdataengdevuks01"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read_Customers_Table",
						"description": "reading customer table",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "fsdf",
									"table_name": "fasdas"
								}
							},
							"firstRowOnly": false
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-13T21:46:36Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_SQL_SERVER')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO_INGESTION')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Execute_Send_email_pipeline",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "check_soruce_count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_EMAIL_DEMO",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"status": "SUCCESS",
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Execute_Send_email_pipeline_for_failer",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "check_soruce_count",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_EMAIL_DEMO",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"status": "Failed",
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Read_Watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT watermark_value from metadata.table_watermarks WHERE table_name = '@{toLower(pipeline().parameters.table_name)}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "check_soruce_count",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "check count in source",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('check count in source').output.firstRow.Count, 0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Ingest_SQL_DB_Data",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT * from dbo.@{pipeline().parameters.table_name} WHERE modifieddate  > '@{activity('Read_Watermark').output.firstRow.watermark_value}'",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_SERVER",
											"type": "DatasetReference",
											"parameters": {
												"schema": "dbo",
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_CSV_DEMO",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Update_Watermark_date",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Ingest_SQL_DB_Data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_SQL_SERVER",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE metadata.table_watermarks\nSET watermark_value = SYSUTCDATETIME()\nWHERE table_name = '@{pipeline().parameters.table_name}';",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "check count in source",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Read_Watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "Select count(*) as count from dbo.@{pipeline().parameters.table_name} where modifieddate > '@{activity('Read_Watermark').output.firstRow.watermark_value}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string",
						"defaultValue": "customers"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-21T15:57:48Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/PL_EMAIL_DEMO')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_SERVER')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_CSV_DEMO')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_SQL_SERVER')]"
			]
		},
